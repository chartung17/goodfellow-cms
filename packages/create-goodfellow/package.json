{
  "name": "create-goodfellow",
  "version": "0.1.0",
  "description": "Creates a new Goodfellow site: npm create goodfellow@latest my-site",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "create",
    "starter",
    "scaffold"
  ],
  "homepage": "https://chartung17.github.io/goodfellow-cms/docs/create-a-site",
  "bugs": "https://github.com/chartung17/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartung17/goodfellow-cms.git",
    "directory": "packages/create-goodfellow"
  },
  "type": "module",
  "bin": {
    "create-goodfellow": "./bin/create-goodfellow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && node scripts/bundle-templates.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow-cms/core": "workspace:*"
  },
  "devDependencies": {
    "@goodfellow-cms/example-parish": "workspace:*",
    "@goodfellow-cms/registry": "workspace:*",
    "@goodfellow-cms/template-next": "workspace:*",
    "@goodfellow-cms/template-starter": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
