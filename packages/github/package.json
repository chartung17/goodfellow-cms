{
  "name": "@goodfellow/github",
  "version": "0.0.0",
  "description": "Edit a Goodfellow site stored on GitHub, straight from the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow/core": "workspace:*"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0"
  }
}
