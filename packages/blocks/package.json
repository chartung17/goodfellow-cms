{
  "name": "@goodfellow/blocks",
  "version": "0.0.0",
  "description": "Goodfellow's built-in blocks. Styled with Tailwind and the site theme only.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "blocks",
    "tailwind"
  ],
  "homepage": "https://chartung17.github.io/goodfellow-cms/docs/built-in-blocks",
  "bugs": "https://github.com/chartung17/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartung17/goodfellow-cms.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow/core": "workspace:*",
    "@goodfellow/react": "workspace:*",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
